# Attend Ease Environment Configuration
# Public API Base URL for future Go backend integration
# Note: Public environment variables (NEXT_PUBLIC_*) are exposed to the browser client and must never contain secrets.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# Frontend Mock Mode ('true' to enable realistic client-side mock services, 'false' for live backend API)
NEXT_PUBLIC_ENABLE_MOCK_API=true

# Geofence default tolerance radius in meters
NEXT_PUBLIC_DEFAULT_GEOFENCE_RADIUS=150

# Testing only: skip the GPS geofence check on check-in (laptops without GPS locate by IP).
# Must be false for real use.
NEXT_PUBLIC_SKIP_GEOFENCE=false
