# Attend Ease — Backend Environment Configuration
# Copy this file to .env and adjust variables as needed:
#   cp .env.example .env

# Application Mode & Network
APP_ENV=development
APP_PORT=8080
APP_URL=http://localhost:8080
FRONTEND_URLS=http://localhost:3000,http://127.0.0.1:3000

# MySQL 8.0 Database Connection
# Dedicated least-privilege credentials provisioned via backend/scripts/setup_db.sql
DB_HOST=localhost
DB_PORT=3306
DB_USER=attend_ease_user
DB_PASSWORD=attend_ease_dev_secret_2026
DB_NAME=attend_ease
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_MINUTES=15

# Authentication & Session Tokens
JWT_SECRET=attend-ease-dev-super-secure-jwt-secret-key-32chars
TOKEN_DURATION_HOURS=24
SESSION_COOKIE_NAME=attend_ease_session
SECURE_COOKIES=false

# Self-Hosted Biometric Verification Service (Python / ONNX / FastAPI)
# Keep false until the face-matching service exists. While false, face checks are demo-only
# and offline check-ins are never rejected because of a face score.
BIOMETRIC_ENABLED=false
BIOMETRIC_SERVICE_URL=http://localhost:5001
BIOMETRIC_TIMEOUT_SECONDS=5
FACE_SCORE_THRESHOLD=0.85

# Transactional Email Delivery (Local development logs links safely to console)
MAIL_DRIVER=log
MAIL_FROM=noreply@attendease.internal

# Logging & Observability
LOG_LEVEL=debug
